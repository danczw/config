#!/bin/bash
# Launch a zellij tab with one pane per named claude agent (see zellij/layouts/rig.kdl).
# Inside zellij it opens a "rig" tab in the current session; outside it starts a new session.
# An optional message becomes gate's first task, passed in its startup prompt.
# "rig send" types a message into a pane (a role name or a pane id) and presses Enter.
# "rig model" types /model into every agent, or one, and confirms the cache dialog; it only lands while the agent is idle.
# "rig broadcast" sends a message to every agent; it only lands while the agents are idle.
# The team is "gate" plus 1-5 workers: -t role[:model[:mode]],... or .rig.toml ([[agent]] tables with role, model, mode)
# in the project dir, else gate,exec,watch. A role's model and mode override -m and -p; each role needs an agent file rig-<role>.
# Usage: rig up [-C dir] [-m model] [-p mode] [-t team] [message] | rig down [-C dir] | rig send [-C dir] <pane> <message> | rig send --list
#        rig model [-C dir] [all|role] <model> | rig broadcast [-C dir] <message>

LAYOUT="$(dirname "$(realpath "$0")")/../zellij/layouts/rig.kdl"

usage() {
    echo "usage: rig up [-C dir] [-m model] [-p mode] [-t team] [message] | rig down [-C dir] | rig send [-C dir] <pane> <message> | rig send --list | rig model [-C dir] [all|role] <model> | rig broadcast [-C dir] <message>" >&2
    exit 1
}

[ $# -ge 1 ] || usage
cmd="$1"
shift

list=false
if [ "$cmd" = send ] && [ "$1" = --list ]; then
    list=true
    shift
fi

dir="$PWD"
model=""
mode=""
team=""
while getopts 'C:m:p:t:' option; do
    case $option in
        C) dir="$OPTARG" ;;
        m) model="$OPTARG" ;;
        p) mode="$OPTARG" ;;
        t) team="$OPTARG" ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))
args=("$@")
message="$*"

cd "$dir" || exit 1
session="rig-$(basename "$PWD")"

# Exit unless the argument looks like a model alias or id (it ends up in a KDL string and in a typed command)
check_model() {
    local pattern='^[][A-Za-z0-9._-]+$'
    [[ "$1" =~ $pattern ]] || {
        echo "rig: invalid model \"$1\"" >&2
        exit 1
    }
}

# Exit unless the argument is a permission mode that rig allows (bypassPermissions is left out on purpose)
check_mode() {
    case "$1" in
        acceptEdits | auto | dontAsk | manual | plan) ;;
        *)
            echo "rig: invalid mode \"$1\" (acceptEdits, auto, dontAsk, manual, plan)" >&2
            exit 1
            ;;
    esac
}

# Fill roles, role_model and role_mode from -t, else .rig.toml, else the default team; exit on an invalid team
roles=()
role_model=()
role_mode=()
load_team() {
    local spec="$team" entries entry role m p extra pattern='^[A-Za-z0-9_-]+$' agents="$HOME/.claude/agents"
    if [ -z "$spec" ] && [ -f .rig.toml ]; then
        spec="$(python3 -c '
import sys, tomllib
try:
    with open(sys.argv[1], "rb") as f:
        agents = tomllib.load(f).get("agent", [])
    print(",".join("%s:%s:%s" % (a["role"], a.get("model", ""), a.get("mode", "")) for a in agents))
except (OSError, tomllib.TOMLDecodeError, KeyError, TypeError, AttributeError) as e:
    sys.exit("rig: .rig.toml: %r" % e)
' .rig.toml)" || exit 1
    fi
    [ -n "$spec" ] || [ -f .rig.toml ] || spec="gate,exec,watch"
    IFS=, read -ra entries <<< "$spec"
    for entry in "${entries[@]}"; do
        IFS=: read -r role m p extra <<< "$entry"
        [[ "$role" =~ $pattern ]] || { echo "rig: invalid role \"$role\"" >&2; exit 1; }
        [ -z "$extra" ] || { echo "rig: invalid team entry \"$entry\" (role[:model[:mode]])" >&2; exit 1; }
        [[ " ${roles[*]} " != *" $role "* ]] || { echo "rig: duplicate role \"$role\"" >&2; exit 1; }
        [ -f "$agents/rig-$role.md" ] || { echo "rig: no agent file $agents/rig-$role.md (run install.sh)" >&2; exit 1; }
        [ -z "$m" ] || check_model "$m"
        [ -z "$p" ] || check_mode "$p"
        roles+=("$role")
        role_model+=("$m")
        role_mode+=("$p")
    done
    [ "${roles[0]}" = gate ] || { echo "rig: the team must start with gate" >&2; exit 1; }
    [ ${#roles[@]} -ge 2 ] && [ ${#roles[@]} -le 6 ] || { echo "rig: the team needs 1-5 workers besides gate" >&2; exit 1; }
}

# Print the claude flags (as KDL strings) for team member $1: its own model and mode, else -m and -p
role_args() {
    local m="${role_model[$1]:-$model}" p="${role_mode[$1]:-$mode}" out=""
    [ -z "$m" ] || out="\"--model\" \"$m\""
    [ -z "$p" ] || out+=" \"--permission-mode\" \"$p\""
    printf '%s' "$out"
}

# Print the KDL for the worker panes: one stacked column, or two side by side from four workers on
worker_panes() {
    local n=$((${#roles[@]} - 1)) i out="" split
    split=$n
    [ "$n" -lt 4 ] || split=$(((n + 1) / 2))
    emit() { out+=$'\n'"$1"; }
    pane() {
        emit "                pane name=\"$2\" command=\"claude\" {"
        emit "                    args \"--agent\" \"rig-$2\" \"--name\" \"$2\" $(role_args "$1") \"Startup: use ListAgents to find the session named gate, then SendMessage it one short line saying $2 is ready and what your role is. Do nothing else until gate sends you a task.\""
        emit "                }"
    }
    [ "$n" -lt 4 ] || emit "                pane split_direction=\"vertical\" {"
    emit "                pane split_direction=\"horizontal\" {"
    for ((i = 1; i <= n; i++)); do
        pane "$i" "${roles[$i]}"
        if [ "$i" -eq "$split" ] && [ "$i" -lt "$n" ]; then
            emit "                }"
            emit "                pane split_direction=\"horizontal\" {"
        fi
    done
    emit "                }"
    [ "$n" -lt 4 ] || emit "                }"
    out="${out#$'\n'}"
    # the template places the first line, so drop its indent
    printf '%s' "${out#"${out%%[![:space:]]*}"}"
}

# Print the layout template with the team's panes, model and mode flags and gate's startup prompt filled in (escaped for a KDL string)
render_layout() {
    # bash 5.2 would treat & in the replacement as the matched text
    shopt -u patsub_replacement 2>/dev/null
    local workers=("${roles[@]:1}") list prompt
    case ${#workers[@]} in
        1) list="${workers[0]} has" ;;
        2) list="both ${workers[0]} and ${workers[1]} have" ;;
        *)
            list="${workers[*]:0:${#workers[@]}-1}"
            list="${list// /, } and ${workers[-1]} have"
            ;;
    esac
    prompt="Startup: wait until $list sent you a ready message."
    if [ -n "${message//[[:space:]]/}" ]; then
        prompt+=" Then start on this first request from the user: ${message}"
    else
        prompt+=" Then tell the user the team is ready."
    fi
    prompt="${prompt//\\/\\\\}"
    prompt="${prompt//\"/\\\"}"
    prompt="${prompt//$'\n'/\\n}"
    local layout panes
    layout="$(< "$LAYOUT")"
    panes="$(worker_panes)"
    layout="${layout//__WORKER_PANES__/$panes}"
    layout="${layout//__CLAUDE_ARGS__/$(role_args 0)}"
    printf '%s\n' "${layout//__GATE_PROMPT__/$prompt}"
}

# Run a zellij action, targeting the rig session when called from outside zellij
zj() {
    if [ -n "$ZELLIJ" ]; then
        zellij action "$@"
    else
        ZELLIJ_SESSION_NAME="$session" zellij action "$@"
    fi
}

# List the rig tab's agent panes as "<name> <pane id> <agent>"
rig_panes() {
    zj list-panes --json --tab --command | python3 -c '
import json, re, sys
for p in json.load(sys.stdin):
    cmd = p.get("terminal_command") or ""
    name = re.search(r"--name (\S+)", cmd)
    agent = re.search(r"--agent (\S+)", cmd)
    if p["tab_name"] == "rig" and not p["is_plugin"] and name:
        print(name.group(1), "terminal_%d" % p["id"], agent.group(1) if agent else "-")
'
}

# Print the pane id for a role name; pane ids pass through unchanged
resolve_pane() {
    case "$1" in
        terminal_* | [0-9]*) echo "$1" ;;
        *) rig_panes | awk -v t="$1" '$1 == t { print $2 }' ;;
    esac
}

# Type a message into one pane (a role name or a pane id) and press Enter;
# a third argument presses Enter once more to accept a confirmation dialog
send_to() {
    local target="$1" text="$2" confirm="$3" pane
    # A newline would submit early in claude's input box
    text="${text//$'\n'/ }"
    pane="$(resolve_pane "$target")"
    if [ -z "$pane" ] || [ "$(wc -l <<< "$pane")" -ne 1 ]; then
        echo "rig: no unique pane matching \"$target\"" >&2
        return 1
    fi
    zj write-chars --pane-id "$pane" -- "$text" > /dev/null || return 1
    sleep 0.2
    zj write --pane-id "$pane" 13 > /dev/null || return 1
    [ -z "$confirm" ] && return 0
    sleep 0.5
    zj write --pane-id "$pane" 13 > /dev/null
}

warn_running() {
    [ -z "$message" ] || echo "rig: already running, message not sent" >&2
    [ -z "$model" ] || echo "rig: already running, model not changed (use rig model)" >&2
    [ -z "$mode" ] || echo "rig: already running, mode not changed" >&2
    [ -z "$team" ] || echo "rig: already running, team not changed" >&2
}

case "$cmd" in
    up)
        [ -z "$model" ] || check_model "$model"
        [ -z "$mode" ] || check_mode "$mode"
        load_team
        if [ -n "$ZELLIJ" ]; then
            if zellij action query-tab-names | grep -qxF rig; then
                warn_running
                exec zellij action go-to-tab-name rig > /dev/null
            fi
            exec zellij action new-tab --name rig --cwd "$PWD" --layout-string "$(render_layout)" > /dev/null
        fi
        if zellij list-sessions --short 2>/dev/null | grep -qxF "$session"; then
            warn_running
            exec zellij attach "$session"
        fi
        exec zellij --session "$session" --layout-string "$(render_layout)"
        ;;
    down)
        if [ -n "$ZELLIJ" ]; then
            zellij action go-to-tab-name rig > /dev/null && zellij action close-tab > /dev/null
        else
            zellij kill-session "$session"
        fi
        ;;
    send)
        if $list; then
            rig_panes
            exit
        fi
        [ ${#args[@]} -ge 2 ] || usage
        send_to "${args[0]}" "${args[*]:1}" || exit 1
        ;;
    model)
        [ ${#args[@]} -ge 1 ] && [ ${#args[@]} -le 2 ] || usage
        target=all
        [ ${#args[@]} -eq 1 ] || target="${args[0]}"
        name="${args[${#args[@]} - 1]}"
        check_model "$name"
        if [ "$target" = all ]; then
            targets="$(rig_panes | awk '{ print $1 }')"
            [ -n "$targets" ] || { echo "rig: no agent panes found" >&2; exit 1; }
        else
            targets="$target"
        fi
        status=0
        for t in $targets; do
            send_to "$t" "/model $name" confirm && echo "$t: /model $name" || status=1
        done
        exit $status
        ;;
    broadcast)
        [ -n "${message//[[:space:]]/}" ] || usage
        targets="$(rig_panes | awk '{ print $1 }')"
        [ -n "$targets" ] || { echo "rig: no agent panes found" >&2; exit 1; }
        status=0
        for t in $targets; do
            send_to "$t" "$message" && echo "$t: sent" || status=1
        done
        exit $status
        ;;
    *)
        usage
        ;;
esac
