#!/bin/bash
# Launch a zellij tab with one pane per named claude agent (see zellij/layouts/rig.kdl).
# Inside zellij it opens a "rig" tab in the current session; outside it starts a new session.
# An optional message becomes the lead's first task, passed in its startup prompt.
# "rig send" types a message into a pane (a role name or a pane id) and presses Enter.
# "rig model" types /model into every agent, or one, and confirms the cache dialog; it only lands while the agent is idle.
# "rig broadcast" sends a message to every agent; it only lands while the agents are idle.
# Usage: rig up [-C dir] [-m model] [message] | rig down [-C dir] | rig send [-C dir] <pane> <message> | rig send --list
#        rig model [-C dir] [all|role] <model> | rig broadcast [-C dir] <message>

LAYOUT="$(dirname "$(realpath "$0")")/../zellij/layouts/rig.kdl"

usage() {
    echo "usage: rig up [-C dir] [-m model] [message] | rig down [-C dir] | rig send [-C dir] <pane> <message> | rig send --list | rig model [-C dir] [all|role] <model> | rig broadcast [-C dir] <message>" >&2
    exit 1
}

[ $# -ge 1 ] || usage
cmd="$1"
shift

list=false
if [ "$cmd" = send ] && [ "$1" = --list ]; then
    list=true
    shift
fi

dir="$PWD"
model=""
while getopts 'C:m:' option; do
    case $option in
        C) dir="$OPTARG" ;;
        m) model="$OPTARG" ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))
args=("$@")
message="$*"

cd "$dir" || exit 1
session="rig-$(basename "$PWD")"

# Exit unless the argument looks like a model alias or id (it ends up in a KDL string and in a typed command)
check_model() {
    local pattern='^[][A-Za-z0-9._-]+$'
    [[ "$1" =~ $pattern ]] || {
        echo "rig: invalid model \"$1\"" >&2
        exit 1
    }
}

# Print the layout template with the model flag and the lead's startup prompt filled in (escaped for a KDL string)
render_layout() {
    # bash 5.2 would treat & in the replacement as the matched text
    shopt -u patsub_replacement 2>/dev/null
    local prompt="Startup: wait until both builder and reviewer have sent you a ready message."
    if [ -n "${message//[[:space:]]/}" ]; then
        prompt+=" Then start on this first request from the user: ${message}"
    else
        prompt+=" Then tell the user the team is ready."
    fi
    prompt="${prompt//\\/\\\\}"
    prompt="${prompt//\"/\\\"}"
    prompt="${prompt//$'\n'/\\n}"
    local model_args=""
    [ -z "$model" ] || model_args="\"--model\" \"$model\""
    local layout
    layout="$(< "$LAYOUT")"
    layout="${layout//__MODEL_ARGS__/$model_args}"
    printf '%s\n' "${layout//__LEAD_PROMPT__/$prompt}"
}

# Run a zellij action, targeting the rig session when called from outside zellij
zj() {
    if [ -n "$ZELLIJ" ]; then
        zellij action "$@"
    else
        ZELLIJ_SESSION_NAME="$session" zellij action "$@"
    fi
}

# List the rig tab's agent panes as "<name> <pane id> <agent>"
rig_panes() {
    zj list-panes --json --tab --command | python3 -c '
import json, re, sys
for p in json.load(sys.stdin):
    cmd = p.get("terminal_command") or ""
    name = re.search(r"--name (\S+)", cmd)
    agent = re.search(r"--agent (\S+)", cmd)
    if p["tab_name"] == "rig" and not p["is_plugin"] and name:
        print(name.group(1), "terminal_%d" % p["id"], agent.group(1) if agent else "-")
'
}

# Print the pane id for a role name; pane ids pass through unchanged
resolve_pane() {
    case "$1" in
        terminal_* | [0-9]*) echo "$1" ;;
        *) rig_panes | awk -v t="$1" '$1 == t { print $2 }' ;;
    esac
}

# Type a message into one pane (a role name or a pane id) and press Enter;
# a third argument presses Enter once more to accept a confirmation dialog
send_to() {
    local target="$1" text="$2" confirm="$3" pane
    # A newline would submit early in claude's input box
    text="${text//$'\n'/ }"
    pane="$(resolve_pane "$target")"
    if [ -z "$pane" ] || [ "$(wc -l <<< "$pane")" -ne 1 ]; then
        echo "rig: no unique pane matching \"$target\"" >&2
        return 1
    fi
    zj write-chars --pane-id "$pane" -- "$text" > /dev/null || return 1
    sleep 0.2
    zj write --pane-id "$pane" 13 > /dev/null || return 1
    [ -z "$confirm" ] && return 0
    sleep 0.5
    zj write --pane-id "$pane" 13 > /dev/null
}

warn_running() {
    [ -z "$message" ] || echo "rig: already running, message not sent" >&2
    [ -z "$model" ] || echo "rig: already running, model not changed (use rig model)" >&2
}

case "$cmd" in
    up)
        [ -z "$model" ] || check_model "$model"
        if [ -n "$ZELLIJ" ]; then
            if zellij action query-tab-names | grep -qxF rig; then
                warn_running
                exec zellij action go-to-tab-name rig > /dev/null
            fi
            exec zellij action new-tab --name rig --cwd "$PWD" --layout-string "$(render_layout)" > /dev/null
        fi
        if zellij list-sessions --short 2>/dev/null | grep -qxF "$session"; then
            warn_running
            exec zellij attach "$session"
        fi
        exec zellij --session "$session" --layout-string "$(render_layout)"
        ;;
    down)
        if [ -n "$ZELLIJ" ]; then
            zellij action go-to-tab-name rig > /dev/null && zellij action close-tab > /dev/null
        else
            zellij kill-session "$session"
        fi
        ;;
    send)
        if $list; then
            rig_panes
            exit
        fi
        [ ${#args[@]} -ge 2 ] || usage
        send_to "${args[0]}" "${args[*]:1}" || exit 1
        ;;
    model)
        [ ${#args[@]} -ge 1 ] && [ ${#args[@]} -le 2 ] || usage
        target=all
        [ ${#args[@]} -eq 1 ] || target="${args[0]}"
        name="${args[${#args[@]} - 1]}"
        check_model "$name"
        if [ "$target" = all ]; then
            targets="$(rig_panes | awk '{ print $1 }')"
            [ -n "$targets" ] || { echo "rig: no agent panes found" >&2; exit 1; }
        else
            targets="$target"
        fi
        status=0
        for t in $targets; do
            send_to "$t" "/model $name" confirm && echo "$t: /model $name" || status=1
        done
        exit $status
        ;;
    broadcast)
        [ -n "${message//[[:space:]]/}" ] || usage
        targets="$(rig_panes | awk '{ print $1 }')"
        [ -n "$targets" ] || { echo "rig: no agent panes found" >&2; exit 1; }
        status=0
        for t in $targets; do
            send_to "$t" "$message" && echo "$t: sent" || status=1
        done
        exit $status
        ;;
    *)
        usage
        ;;
esac
