#!/bin/bash
# Launch a zellij tab with one pane per named claude agent (see zellij/layouts/rig.kdl).
# Inside zellij it opens a "rig" tab in the current session; outside it starts a new session.
# An optional message becomes the lead's first task, passed in its startup prompt.
# "rig send" types a message into a pane (a role name or a pane id) and presses Enter.
# Usage: rig up [-C dir] [message] | rig down [-C dir] | rig send [-C dir] <pane> <message> | rig send --list

LAYOUT="$(dirname "$(realpath "$0")")/../zellij/layouts/rig.kdl"

usage() {
    echo "usage: rig up [-C dir] [message] | rig down [-C dir] | rig send [-C dir] <pane> <message> | rig send --list" >&2
    exit 1
}

[ $# -ge 1 ] || usage
cmd="$1"
shift

list=false
if [ "$cmd" = send ] && [ "$1" = --list ]; then
    list=true
    shift
fi

dir="$PWD"
while getopts 'C:' option; do
    case $option in
        C) dir="$OPTARG" ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))
args=("$@")
message="$*"

cd "$dir" || exit 1
session="rig-$(basename "$PWD")"

# Print the layout template with the lead's startup prompt filled in (escaped for a KDL string)
render_layout() {
    # bash 5.2 would treat & in the replacement as the matched text
    shopt -u patsub_replacement 2>/dev/null
    local prompt="Startup: wait until both builder and reviewer have sent you a ready message."
    if [ -n "${message//[[:space:]]/}" ]; then
        prompt+=" Then start on this first request from the user: ${message}"
    else
        prompt+=" Then tell the user the team is ready."
    fi
    prompt="${prompt//\\/\\\\}"
    prompt="${prompt//\"/\\\"}"
    prompt="${prompt//$'\n'/\\n}"
    local layout
    layout="$(< "$LAYOUT")"
    printf '%s\n' "${layout//__LEAD_PROMPT__/$prompt}"
}

# Run a zellij action, targeting the rig session when called from outside zellij
zj() {
    if [ -n "$ZELLIJ" ]; then
        zellij action "$@"
    else
        ZELLIJ_SESSION_NAME="$session" zellij action "$@"
    fi
}

# List the rig tab's agent panes as "<name> <pane id> <agent>"
rig_panes() {
    zj list-panes --json --tab --command | python3 -c '
import json, re, sys
for p in json.load(sys.stdin):
    cmd = p.get("terminal_command") or ""
    name = re.search(r"--name (\S+)", cmd)
    agent = re.search(r"--agent (\S+)", cmd)
    if p["tab_name"] == "rig" and not p["is_plugin"] and name:
        print(name.group(1), "terminal_%d" % p["id"], agent.group(1) if agent else "-")
'
}

# Print the pane id for a role name; pane ids pass through unchanged
resolve_pane() {
    case "$1" in
        terminal_* | [0-9]*) echo "$1" ;;
        *) rig_panes | awk -v t="$1" '$1 == t { print $2 }' ;;
    esac
}

warn_running() {
    [ -z "$message" ] || echo "rig: already running, message not sent" >&2
}

case "$cmd" in
    up)
        if [ -n "$ZELLIJ" ]; then
            if zellij action query-tab-names | grep -qxF rig; then
                warn_running
                exec zellij action go-to-tab-name rig > /dev/null
            fi
            exec zellij action new-tab --name rig --cwd "$PWD" --layout-string "$(render_layout)" > /dev/null
        fi
        if zellij list-sessions --short 2>/dev/null | grep -qxF "$session"; then
            warn_running
            exec zellij attach "$session"
        fi
        exec zellij --session "$session" --layout-string "$(render_layout)"
        ;;
    down)
        if [ -n "$ZELLIJ" ]; then
            zellij action go-to-tab-name rig > /dev/null && zellij action close-tab > /dev/null
        else
            zellij kill-session "$session"
        fi
        ;;
    send)
        if $list; then
            rig_panes
            exit
        fi
        [ ${#args[@]} -ge 2 ] || usage
        target="${args[0]}"
        text="${args[*]:1}"
        # A newline would submit early in claude's input box
        text="${text//$'\n'/ }"
        pane="$(resolve_pane "$target")"
        if [ -z "$pane" ] || [ "$(wc -l <<< "$pane")" -ne 1 ]; then
            echo "rig: no unique pane matching \"$target\"" >&2
            exit 1
        fi
        zj write-chars --pane-id "$pane" -- "$text" > /dev/null || exit 1
        sleep 0.2
        zj write --pane-id "$pane" 13 > /dev/null
        ;;
    *)
        usage
        ;;
esac
