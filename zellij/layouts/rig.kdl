// multi-agent rig: one tab, lead on the left, builder and reviewer stacked on the right
layout {
    // a layout replaces the default bars, so restate them to keep the tab bar visible
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="rig" {
        pane split_direction="vertical" {
            pane name="lead" focus=true size="55%" command="claude" {
                args "--agent" "rig-lead" "--name" "lead" "Startup: wait until both builder and reviewer have sent you a ready message. Then, if the file ~/.cache/rig/task exists, read it and treat its contents as the user's first request and start working on it. If it does not exist, just tell the user the team is ready."
            }
            pane split_direction="horizontal" {
                pane name="builder" command="claude" {
                    args "--agent" "rig-builder" "--name" "builder" "Startup: use ListAgents to find the session named lead, then SendMessage it one short line saying builder is ready for work. Do nothing else until the lead sends you a task."
                }
                pane name="reviewer" command="claude" {
                    args "--agent" "rig-reviewer" "--name" "reviewer" "Startup: use ListAgents to find the session named lead, then SendMessage it one short line saying reviewer is ready for work. Do nothing else until the lead sends you a task."
                }
            }
        }
    }
}
