// template rendered by bin/rig (its double-underscore placeholders are filled in); not meant to be loaded directly
// multi-agent rig: one tab, gate on the left, the worker panes (generated from the team) on the right
layout {
    // a layout replaces the default bars, so restate them to keep the tab bar visible
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="rig" {
        pane split_direction="vertical" {
            pane name="gate" focus=true size="45%" command="claude" {
                args "--agent" "rig-gate" "--name" "gate" __CLAUDE_ARGS__ "__GATE_PROMPT__"
            }
            __WORKER_PANES__
        }
    }
}
